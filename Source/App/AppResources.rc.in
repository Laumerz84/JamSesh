// The standalone app's Windows resources: its icon (Source/Resources/JamSesh.ico, drawn by
// tools/icon/make-icon.ps1; also the window's icon) and its version resource (file properties, Task
// Manager, the Firewall prompt). CMakeLists.txt fills it in; the plugin keeps the resources JUCE writes.
#pragma code_page(65001)

#include <windows.h>

1 ICON "@CLOD_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName",  "Clod Codes\0"
      VALUE "FileDescription",  "@CLOD_APP_NAME@\0"
      VALUE "FileVersion",  "@PROJECT_VERSION@\0"
      VALUE "LegalCopyright",  "Copyright (C) 2026 Clod Codes. Free software under the GNU GPL version 3.\0"
      VALUE "ProductName",  "@CLOD_APP_NAME@\0"
      VALUE "ProductVersion",  "@PROJECT_VERSION@\0"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
